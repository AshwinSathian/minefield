{
  "name": "minefield",
  "version": "1.0.0",
  "description": "Minesweeper for the browser with boards you can always solve by logic, an exact probability solver, and hints that explain themselves.",
  "homepage": "https://minefield.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/minefield.git"
  },
  "license": "MIT",
  "author": "Ashwin Sathian",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node scripts/bench.ts",
    "flow": "node scripts/flow.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test src/*.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "wrangler": "^4.165.0"
  }
}
